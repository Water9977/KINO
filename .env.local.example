# Server-only. Never prefix this with NEXT_PUBLIC_ — that would ship the key
# to every browser. All TMDB calls happen in Server Components / Server Actions.
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Absolute origin, used for canonical URLs, sitemap.xml and Open Graph.
NEXT_PUBLIC_SITE_URL=https://kino-web-neon.vercel.app

# Optional. `next build` now FAILS when TMDB can't be reached (or the key is missing), so an
# outage can't bake an empty site into a deploy. Set this to 1 to let a build finish anyway with
# empty sections, e.g. on a network that blocks TMDB; pages refresh on the first request after
# their 5-minute revalidate window.
# TMDB_ALLOW_EMPTY_BUILD=1
